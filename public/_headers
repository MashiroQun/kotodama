# Cloudflare Pages: keep the PWA's HTML and worker update checks fresh.
# This file is copied from public/ to dist/ by Vite.
/
  Cache-Control: no-cache, max-age=0, must-revalidate

/index.html
  Cache-Control: no-cache, max-age=0, must-revalidate

/sw.js
  Cache-Control: no-cache, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache, max-age=0, must-revalidate

/update-recovery.html
  Cache-Control: no-store, max-age=0
